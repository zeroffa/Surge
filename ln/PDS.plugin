#!name=🧧 PChome 每日簽到 IN Loon REF.JKGTW
#!desc=每日自動 PChome App 簽到；預設 08:01~08:05 之間每日隨機一次。請先手動開啟 app 簽到頁或手動簽到時自動擷取 Cookie。v20260814.01
#!system=ios

[Argument]
cron = input,"1-5 8 * * *",tag=執行時間,desc=每日執行時間

[Script]
http-request ^https:\/\/ecapi\.pchome\.com\.tw\/fsapi\/marketing\/signingift\/v1\/(activity|signin) script-path=https://raw.githubusercontent.com/jkgtw/Surge/refs/heads/master/JS/pchome_cookie.js,requires-body=false,timeout=5,debug=false,tag=PChome Cookie,argument=[{cron}]

cron {cron} script-path=https://raw.githubusercontent.com/jkgtw/Surge/refs/heads/master/JS/pchome_signin.js,timeout=20,debug=false,tag=PChome Signin,argument=[{cron}]

[MITM]
hostname = ecapi.pchome.com.tw
