#!name=🧧 PChome 每日簽到 IN Loon REF.JKGTW
#!desc=每日自動 PChome App 簽到；預設 08:01~08:05 之間每日隨機一次。請先手動開啟 app 簽到頁或手動簽到時自動擷取 Cookie。v20260814.01
#!system=ios

[Argument]
cron = input,"1-5 8 * * *",tag=執行時間,desc=Cron 表達式

[Script]

request if ${url} ~= /^https:\/\/ecapi\.pchome\.com\.tw\/fsapi\/marketing\/signingift\/v1\/(activity|signin)/i then script("https://raw.githubusercontent.com/jkgtw/Surge/refs/heads/master/JS/pchome_cookie.js") with tag="PChome Cookie", timeout=5, debug=false, requires_body=false

cron ${cron} then script("https://github.com/zeroffa/Surge/raw/refs/heads/master/ln/PDS.js", {${cron}}) with tag="PChome Signin", timeout=20, debug=false

[MITM]
hostname = ecapi.pchome.com.tw
