#!name=1min.ai 參數測試 v20260830.04
#!desc=測試 Loon 3.5.0 舊版 Plugin Script 參數
#!system=ios
#!category=Automation

[Argument]
帳號 = input,"TEST_EMAIL"
密碼 = input,"TEST_PASSWORD"
TOTP金鑰 = input,"null"

[Script]
cron "0 20 23 * * *" script-path=https://github.com/zeroffa/Surge/raw/refs/heads/master/ln/1min_argument_test.js,argument="email=${帳號}&password=${密碼}&totp=${TOTP金鑰}",tag=1min.ai參數測試,timeout=30

[MITM]
hostname = api.1min.ai
